# Copy to .env.local and adjust. Never commit .env.local.

# This app's own API (../backend). Only the Next server talks to it; browsers never do.
API_URL=http://127.0.0.1:8300
# Show a list of demo accounts on the sign-in page (development only). Off:
# those accounts don't exist in this app's own database.
SHOW_DEMO_ACCOUNTS=0

# Which app this is, so the sidebar knows what is a link away.
NEXT_PUBLIC_ORBIT_APP=exec
