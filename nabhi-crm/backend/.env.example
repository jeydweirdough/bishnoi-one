# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# This app's own database: its users, sessions and data. SQLite in .data/ by
# default; point it at Postgres (postgres://... as Neon or Vercel give it)
# without touching anything else.
# DATABASE_URL=sqlite:///.data/crm.db

# The first administrator, for a host you can't run the users tool against
# (Vercel). Used only while the database has no accounts; remove the password
# once they've signed in.
# FIRST_ADMIN_EMAIL=you@example.com
# FIRST_ADMIN_NAME=Your Name
# FIRST_ADMIN_PASSWORD=

# How long a sign-in lasts, in hours.
# SESSION_HOURS=10

# The company this app belongs to, as its screens show it.
# ORG_NAME=Nabhi
# ORG_CURRENCY=PHP
# ORG_LOCALE=en-PH
# ORG_TIMEZONE=Asia/Manila

# Host names this API answers to, as JSON.
# ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Browser origins allowed to call this API directly, as JSON. Empty by default:
# the Next server calls it, browsers don't.
# CORS_ORIGINS=[]

# Nabhi Inventory, where the product list and stock levels come from. Its API
# address, and the key it lists for the CRM in its INTEGRATION_KEYS (the part
# after "crm:"). Unset: products are added and priced here, by hand.
# INVENTORY_API_URL=http://localhost:8304
# INVENTORY_API_KEY=
# Inventory's screens, for the "Add it in Inventory" link on Products.
# INVENTORY_APP_URL=http://localhost:4304

# Nabhi Finance works out tax, the last step of the price rules. Its API, and
# the key it gave the CRM (in Finance's INTEGRATION_KEYS as "crm:<key>").
# Unset: quotes are priced without tax.
# FINANCE_API_URL=http://127.0.0.1:8303
# FINANCE_API_KEY=

# Nabhi Order: where "Raise order" on a ready quote sends it (POST {url}/orders,
# with X-Nabhi-Key and the payload described in app/orders.py). Unset: no button.
# ORDERS_API_URL=https://...
# ORDERS_API_KEY=

# --- Discord (app/discord.py) --------------------------------------------------
# This app's log goes to Discord: a thread a day in the logs channel, named
# LOG-CRM-YYYYMMDD, one line per change (what, to what, who, when; never values).
# Master off switch: nothing goes to Discord unless this is true.
# DISCORD_ENABLED=false
# mock = nothing leaves this machine (a local file in .data/discord-mock/ stands
# in for Discord); live = really post.
# DISCORD_MODE=mock
# The bot: reads the channels back and starts the threads. Developer Portal >
# your app > Bot > Reset Token; turn on Message Content Intent there.
# DISCORD_BOT_TOKEN=
# A webhook in the logs channel (channel > Edit Channel > Integrations >
# Webhooks > New Webhook). Every app may use the same one.
# DISCORD_LOGS_WEBHOOK_URL=
# Most messages a minute. Discord allows about 30 per channel; more wait their turn.
# DISCORD_MAX_PER_MINUTE=30
