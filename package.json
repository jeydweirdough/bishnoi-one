    "nabhi-crm:app": "node scripts/run-app.mjs nabhi-crm --app",
    "nabhi-finance": "node scripts/run-app.mjs nabhi-finance",
    "nabhi-finance:app": "node scripts/run-app.mjs nabhi-finance --app",
    "nabhi-in-licensing": "node scripts/run-app.mjs nabhi-in-licensing",
    "nabhi-inventory": "node scripts/run-app.mjs nabhi-inventory",
    "nabhi-inventory:app": "node scripts/run-app.mjs nabhi-inventory --app",
    "nabhi-pharmacy": "node scripts/run-app.mjs nabhi-pharmacy",
    "nabhi-pharmacy:app": "node scripts/run-app.mjs nabhi-pharmacy --app",
    "nabhi-platform": "node scripts/run-app.mjs nabhi-platform",
    "nabhi-platform:app": "node scripts/run-app.mjs nabhi-platform --app",
    "nabhi-regulatory": "node scripts/run-app.mjs nabhi-regulatory",
