# Copy to .env.local and adjust. Never commit .env.local.

# This app's own API (../backend). Only the Next server talks to it; browsers never do.
API_URL=http://127.0.0.1:8302
# Show the demo accounts on the sign-in page (development only).
SHOW_DEMO_ACCOUNTS=1

# Which app this is, so the sidebar knows what is a link away.
NEXT_PUBLIC_ORBIT_APP=sales
