# Root ignore rules for the whole Nabhi repo. Each project also keeps its own
# .gitignore so it still works if it is ever split into a separate repo.

# Secrets. Never commit these; .env.example documents the names instead.
.env
.env.*
!.env.example
*.pem
*.key

# Node / Next.js
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Backend local data in every nabhi-*/backend: databases, the records file
# store, pre-migration backups, virtual environments
env/
.data/
.data-before-*/
*.db
*.db-shm
*.db-wal
*.sqlite3

# Local Claude plugin data
.claude/data/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
