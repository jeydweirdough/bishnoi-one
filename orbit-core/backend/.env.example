# Copy to .env and fill in. Never commit .env or paste its values into chat.

ENVIRONMENT=development
# "Today" for follow-ups is decided in this timezone.
TIMEZONE=Asia/Manila

# Sign-in tokens are signed with an Ed25519 private key. Leave unset while
# developing (one is made in .data/signing-key.pem). For a live API, make one
# and paste the printed line here or in the host's settings:
#   uv run python -m app.tools.keys
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# After changing keys, the old key's public half keeps its tokens valid until they expire:
#   uv run python -m app.tools.keys --public-of old-key.pem
# JWT_PREVIOUS_PUBLIC_KEYS=[]
# JWT_SECRET is no longer used.

# The Orders app's address, once it's live: the sidebar links to it. Register it
# for one sign-in with: uv run python -m app.tools.sso_client add orders --redirect <its>/sso/callback


# Accounts database (people, teams, roles). SQLite until Supabase is set up.
# Then point this at Supabase's Transaction pooler (Connect -> Transaction pooler):
#   DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
# DATABASE_URL=sqlite:///.data/accounts.db

# Sanity holds the business records. Leave SANITY_PROJECT_ID empty to use a
# local file (.data/local-store.json) while Sanity isn't connected yet.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# sanity.io/manage -> your project -> API -> Tokens -> Add API token, "Editor".
SANITY_TOKEN=

# --- Traffic and security (defaults are safe; set these for production) ---
# The API answers only to these host names (JSON list). Add the name the Next server uses to reach it.
# ALLOWED_HOSTS=["localhost", "127.0.0.1"]
# Browser origins allowed to call the API directly. Leave empty: browsers never do, the Next server does.
# CORS_ORIGINS=[]
# Whose X-Forwarded-For to believe: the Next server, plus any reverse proxy in front of the API.
# TRUSTED_PROXIES=["127.0.0.1", "::1"]
# Requests per minute, per signed-in person (per client address when not signed in).
# RATE_LIMIT_ENABLED=true
# RATE_READS_PER_MINUTE=300
# RATE_WRITES_PER_MINUTE=60
# RATE_UPLOADS_PER_MINUTE=10
# RATE_ANONYMOUS_PER_MINUTE=60
# Bulk actions (up to 500 records each) have their own limit, and are worked
# through in batches: this many records per trip to Sanity, with a pause between.
# RATE_BULK_PER_MINUTE=10
# BULK_BATCH_SIZE=50
# BULK_PAUSE_SECONDS=0.2

# On Postgres, connect the app as a role that can only read and write rows (no CREATE/ALTER/DROP),
# and run migrations as the tables' owner:
# (Supabase: Connect -> Session pooler, port 5432.)
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
