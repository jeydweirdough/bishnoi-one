# Copy to .env.local and adjust. Never commit .env.local.

# This app's own API (../backend). Only the Next server talks to it; browsers never do.
API_URL=http://127.0.0.1:8303
# List this app's demo accounts beside the sign-in form (development only).
# Make them first, in ../backend: uv run python -m app.tools.users demo
SHOW_DEMO_ACCOUNTS=1

# Which app this is, so the sidebar knows what is a link away.
# Built in (next.config.ts): no need to set it. Only to override:
# NEXT_PUBLIC_NABHI_APP=finance

# Nabhi Platform's API, for the announcements shown above every page (kept in Discord).
# Unset: http://127.0.0.1:8305. If it can't be reached, no announcements show.
# PLATFORM_API_URL=http://127.0.0.1:8305
