# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# This app's own database: its users, sessions and data. SQLite in .data/ by
# default; point it at Postgres (or a test database) without touching
# anything else.
# DATABASE_URL=sqlite:///.data/finance.db

# The first administrator, made on start when the database has no accounts at
# all (Vercel + Supabase, where the users tool can't reach the database).
# Ignored once anyone exists: remove the password after the first sign-in.
# FIRST_ADMIN_EMAIL=you@example.com
# FIRST_ADMIN_NAME=Your Name
# FIRST_ADMIN_PASSWORD=

# How long a sign-in lasts, in hours.
# SESSION_HOURS=10

# Signing in with a Bishnoi One account: the platform's public key is fetched
# from PLATFORM_API_URL (its /pass/key), so it isn't set here. Set
# PLATFORM_PUBLIC_KEY (base64) only to pin it.
# PLATFORM_PUBLIC_KEY=

# The company this app belongs to, as its screens show it.
# ORG_NAME=Bishnoi One
# ORG_CURRENCY=PHP
# ORG_LOCALE=en-PH
# ORG_TIMEZONE=Asia/Manila

# Host names this API answers to, as JSON.
# ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Browser origins allowed to call this API directly, as JSON. Empty by default:
# the Next server calls it, browsers don't.
# CORS_ORIGINS=[]

# Other Bishnoi One apps allowed to ask Finance for tax, as name:key pairs in JSON.
# Each app sends its key in the X-Bishnoi-Key header. Keys: 24 characters or more.
# INTEGRATION_KEYS=["crm:<a long random key>", "pharmacy:<another one>"]

# --- Discord (app/discord.py) --------------------------------------------------
# This app's log goes to Discord: a thread a day in the logs channel, named
# LOG-FINANCE-YYYYMMDD, one line per change (what, to what, who, when; never values).
# Master off switch: nothing goes to Discord unless this is true.
# DISCORD_ENABLED=false
# mock = nothing leaves this machine (a local file in .data/discord-mock/ stands
# in for Discord); live = really post.
# DISCORD_MODE=mock
# The bot: reads the channels back and starts the threads. Developer Portal >
# your app > Bot > Reset Token; turn on Message Content Intent there.
# DISCORD_BOT_TOKEN=
# A webhook in the logs channel (channel > Edit Channel > Integrations >
# Webhooks > New Webhook). Every app may use the same one.
# DISCORD_LOGS_WEBHOOK_URL=
# Most messages a minute. Discord allows about 30 per channel; more wait their turn.
# DISCORD_MAX_PER_MINUTE=30

# Bishnoi One CRM, whose customers an invoice is made out to: its API, and the key it
# gave Finance (in the CRM's INTEGRATION_KEYS as "finance:<key>"). Unset: the
# customer is typed on the invoice.
# CRM_API_URL=http://127.0.0.1:8302
# CRM_API_KEY=
# Which company's customers and prices: its short name on Bishnoi One Platform
# (2MG's). Required in production, where the CRM won't fall back to a default.
# CRM_COMPANY=

# Dedicated Finance Zoho connection (local phase 1; never commit actual values).
# Set privately with: uv run python -m app.tools.setup_zoho
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_ENCRYPTION_KEY=
ZOHO_REGION=com
ZOHO_REDIRECT_URI=http://localhost:4301/finance/integrations/zoho/callback


# PostgreSQL compatibility (enable only after the reviewed database upgrade).
# POSTGRES_DRIVER=pg8000
# Keep DATABASE_URL unchanged during compatibility preparation.
# FINANCE_NEON_REVIEW_URL=  # Private, read-only inspection only; not used by the API.
# ZOHO_DATABASE_ENABLED=false
# ZOHO_CONNECTION_ID=     # Stable name for this Finance connection.
# ZOHO_ENVIRONMENT=       # Separate environment binding; copied databases stay inactive.
# ZOHO_WORKER_ENABLED=false
# ZOHO_DAILY_LIMIT=500    # Finance source GET self-cap; not Zoho's whole-org allowance.
# DATA_ENVIRONMENT=local_test # Set official only for the real Finance database.
# ZOHO_NETWORK_ENABLED=false # Local tests must not contact the real Zoho organisation.
# ZOHO_OUTBOX_CAPTURE_ENABLED=false # Official approved-record capture; no historical replay.
# ZOHO_OUTBOUND_ENABLED=false # Enable only after OAuth consent and verified mappings.
