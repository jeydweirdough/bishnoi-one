# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# This app's own database. SQLite in .data/ by default; point it at Postgres
# (or a test database) without touching anything else.
# DATABASE_URL=sqlite:///.data/inventory.db

# Host names this API answers to, as JSON.
# ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Browser origins allowed to call this API directly, as JSON. Empty by default:
# the Next server calls it, browsers don't.
# CORS_ORIGINS=[]
