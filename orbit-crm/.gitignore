# This app has two parts: frontend/ (Next.js) and backend/ (Python API).
# These rules cover both.

# Dependencies
node_modules/
.pnp
.pnp.*

# Next.js build output
.next/
out/
build/
dist/

# Cloudflare build output (OpenNext, wrangler)
.open-next/
.wrangler/
.dev.vars*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Secrets. Never commit these; add a .env.example with the names instead.
.env
.env.*
!.env.example
*.pem

# Logs and test output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage/

# Vercel
.vercel/

# Local Claude plugin data
.claude/data/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python (backend/)
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Backend local data: databases, the records file store, uploaded files, keys
.data/
.data-before-*/
*.db
*.db-shm
*.db-wal
*.sqlite3
*.key
