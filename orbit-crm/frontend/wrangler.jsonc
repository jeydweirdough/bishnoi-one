// How Cloudflare runs these screens (Workers & Pages → orbit-crm).
// Built with OpenNext: `npm run deploy`, or by Cloudflare on every push.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbit-crm",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // API_URL and the rest are set in the dashboard (Settings → Variables and
  // secrets). Keep them when a deploy runs, instead of clearing them.
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "orbit-crm"
    }
  ],
  "observability": {
    "enabled": true
  }
}
