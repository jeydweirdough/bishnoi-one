# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# This app's own database: its users, sessions and data. SQLite in .data/ by
# default; point it at Postgres (or a test database) without touching
# anything else.
# DATABASE_URL=sqlite:///.data/inventory.db

# The first administrator, made on start when the database has no accounts at
# all (Vercel, where the users tool can't reach the database). Ignored once
# anyone exists: remove the password after the first sign-in.
# FIRST_ADMIN_EMAIL=you@example.com
# FIRST_ADMIN_NAME=Your Name
# FIRST_ADMIN_PASSWORD=

# How long a sign-in lasts, in hours.
# SESSION_HOURS=10

# A batch expiring within this many days is flagged as expiring soon.
# EXPIRY_WARNING_DAYS=90
# Stock with nothing issued or transferred out for this long is dead stock.
# DEAD_STOCK_DAYS=180

# The company this app belongs to, as its screens show it.
# ORG_NAME=Nabhi
# ORG_CURRENCY=PHP
# ORG_LOCALE=en-PH
# ORG_TIMEZONE=Asia/Manila

# Host names this API answers to, as JSON.
# ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Browser origins allowed to call this API directly, as JSON. Empty by default:
# the Next server calls it, browsers don't.
# CORS_ORIGINS=[]
