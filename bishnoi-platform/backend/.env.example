# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# This app's own database: its staff, sessions and the platform's records.
# SQLite in .data/ by default; point it at Postgres (postgres://... as Neon,
# Supabase or Vercel give it) without touching anything else.
# DATABASE_URL=sqlite:///.data/platform.db

# The first Platform Admin, for a host you can't run the users tool against.
# Used only while the database has no accounts; remove the password after.
# FIRST_ADMIN_EMAIL=you@example.com
# FIRST_ADMIN_NAME=Your Name
# FIRST_ADMIN_PASSWORD=

# Sign-in rules to start with. Settings > Security changes them from then on.
# SESSION_HOURS=10

# Signs the passes that take a Nabhi account into each app (Ed25519, base64).
# Required in production; each app gets only the public half, as
# PLATFORM_PUBLIC_KEY. Make the pair with: node scripts/deploy-keys.mjs
# (or uv run python -m app.passes). Unset in development: one is kept in .data/.
# PASS_SIGNING_KEY=
# LOGIN_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# The platform, as its screens show it.
# ORG_NAME=Nabhi
# ORG_CURRENCY=PHP
# ORG_LOCALE=en-PH
# ORG_TIMEZONE=Asia/Manila

# Host names this API answers to, as JSON.
# ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Browser origins allowed to call this API directly, as JSON. Empty by default:
# the Next server calls it, browsers don't.
# CORS_ORIGINS=[]

# --- Discord (app/discord.py) --------------------------------------------------
# This app's log goes to Discord: a thread a day in the logs channel, named
# LOG-PLATFORM-YYYYMMDD, one line per change (what, to what, who, when; never values).
# Announcements are kept there too: a thread each in the announcements channel,
# named with its id (ANN-YYYYMMDD-NNNN), holding it as JSON. Every app shows them.
# Master off switch: nothing goes to Discord unless this is true.
# DISCORD_ENABLED=false
# mock = nothing leaves this machine (a local file in .data/discord-mock/ stands
# in for Discord); live = really post.
# DISCORD_MODE=mock
# The bot: reads the channels back and starts the threads. Developer Portal >
# your app > Bot > Reset Token; turn on Message Content Intent there.
# DISCORD_BOT_TOKEN=
# A webhook in the logs channel (channel > Edit Channel > Integrations >
# Webhooks > New Webhook). Every app may use the same one.
# DISCORD_LOGS_WEBHOOK_URL=
# A webhook in its own channel for announcements: not the logs channel.
# DISCORD_ANNOUNCEMENTS_WEBHOOK_URL=
# Most messages a minute. Discord allows about 30 per channel; more wait their turn.
# DISCORD_MAX_PER_MINUTE=30
