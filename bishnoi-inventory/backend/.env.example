# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# This app's own database: its users, sessions and data. SQLite in .data/ by
# default; point it at Postgres (or a test database) without touching
# anything else.
# DATABASE_URL=sqlite:///.data/inventory.db

# The first administrator, made on start when the database has no accounts at
# all (Vercel, where the users tool can't reach the database). Ignored once
# anyone exists: remove the password after the first sign-in.
# FIRST_ADMIN_EMAIL=you@example.com
# FIRST_ADMIN_NAME=Your Name
# FIRST_ADMIN_PASSWORD=

# How long a sign-in lasts, in hours.
# SESSION_HOURS=10

# Signing in with a Bishnoi One account: the platform's public key (base64; the
# platform's /pass/key shows it, and scripts/deploy-keys.mjs makes the pair).
# Unset: only this app's own accounts sign in.
# PLATFORM_PUBLIC_KEY=

# A batch expiring within this many days is flagged as expiring soon.
# EXPIRY_WARNING_DAYS=90
# Stock with nothing issued or transferred out for this long is dead stock.
# DEAD_STOCK_DAYS=180

# The company this app belongs to, as its screens show it.
# ORG_NAME=Bishnoi One
# ORG_CURRENCY=PHP
# ORG_LOCALE=en-PH
# ORG_TIMEZONE=Asia/Manila

# Host names this API answers to, as JSON.
# ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Browser origins allowed to call this API directly, as JSON. Empty by default:
# the Next server calls it, browsers don't.
# CORS_ORIGINS=[]

# Other Bishnoi One apps allowed to read the product list and stock levels, as
# name:key pairs in JSON. The CRM sends its key (its INVENTORY_API_KEY) in the
# X-Bishnoi-Key header. Make a key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# INTEGRATION_KEYS=["crm:<the same key as the CRM's INVENTORY_API_KEY>"]

# --- Discord (app/discord.py) --------------------------------------------------
# This app's log goes to Discord: a thread a day in the logs channel, named
# LOG-INVENTORY-YYYYMMDD, one line per change (what, to what, who, when; never values).
# Master off switch: nothing goes to Discord unless this is true.
# DISCORD_ENABLED=false
# mock = nothing leaves this machine (a local file in .data/discord-mock/ stands
# in for Discord); live = really post.
# DISCORD_MODE=mock
# The bot: reads the channels back and starts the threads. Developer Portal >
# your app > Bot > Reset Token; turn on Message Content Intent there.
# DISCORD_BOT_TOKEN=
# A webhook in the logs channel (channel > Edit Channel > Integrations >
# Webhooks > New Webhook). Every app may use the same one.
# DISCORD_LOGS_WEBHOOK_URL=
# Most messages a minute. Discord allows about 30 per channel; more wait their turn.
# DISCORD_MAX_PER_MINUTE=30

# The online database (Neon) copied into .data/backups/ by
# `uv run python -m app.tools.copy_database backup` (scripts/backup-online-databases.cmd).
# Its pooled address, from the Neon project's Connect button.
# BACKUP_FROM=postgresql://...-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Bishnoi One Platform's API. Each company must be registered there, active and
# given Inventory, or its people can't sign in (app/company.py). Needs
# PLATFORM_PUBLIC_KEY too. Unset: on this computer, the companies in
# DEV_COMPANIES are allowed; in production, none is.
# PLATFORM_API_URL=http://127.0.0.1:8305
#
# One Inventory for many companies: each company's data is in a database of its
# own, beside DATABASE_URL with the company's short name added
# (inventory.db -> inventory-getmeds.db; neondb -> neondb_getmeds), made the first
# time the company is used (app/tenants.py). Point DATABASE_URL at the base
# (neondb), not at a company's. On this computer only, a request that doesn't
# name its company is for DEFAULT_COMPANY.
# DEFAULT_COMPANY=getmeds
# FIRST_ADMIN_* goes into one company's database only: FIRST_ADMIN_COMPANY
# (on this computer, DEFAULT_COMPANY; in production, none unless set).
# FIRST_ADMIN_COMPANY=getmeds
# DEV_COMPANIES=["getmeds","northwind"]
