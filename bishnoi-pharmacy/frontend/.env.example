# Copy to .env.local and adjust. Never commit .env.local.

# This app's own API (../backend). Only the Next server talks to it; browsers never do.
API_URL=http://127.0.0.1:8307
# List this app's demo accounts beside the sign-in form (development only).
# Make them first, in ../backend: uv run python -m app.tools.users demo
SHOW_DEMO_ACCOUNTS=1

# Which app this is, so the sidebar knows what is a link away.
# Built in (next.config.ts): no need to set it. Only to override:
# NEXT_PUBLIC_BISHNOI_APP=pharmacy

# Bishnoi One Platform's API, for the announcements shown above every page (kept in Discord).
# Unset: http://127.0.0.1:8305. If it can't be reached, no announcements show.
# PLATFORM_API_URL=http://127.0.0.1:8305

# The platform's screens, for the "Sign in with your Bishnoi One account" button.
# Built into the screens: set it before building. Unset: no button.
# NEXT_PUBLIC_BISHNOI_PLATFORM_URL=http://localhost:4305

# The other apps' screens, for links from this one (built in too). Unset: the
# local addresses (localhost:4300 to 4308).
# NEXT_PUBLIC_BISHNOI_CRM_URL=http://localhost:4302
# NEXT_PUBLIC_BISHNOI_INVENTORY_URL=http://localhost:4304
# NEXT_PUBLIC_BISHNOI_FINANCE_URL=http://localhost:4303
# NEXT_PUBLIC_BISHNOI_EXEC_URL=http://localhost:4300
# NEXT_PUBLIC_BISHNOI_PHARMACY_URL=http://localhost:4307
