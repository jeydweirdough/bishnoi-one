# Copy to .env.local and adjust. Never commit .env.local.
# Bishnoi One's one app: every module's screens on one site. Only the Next
# server talks to the APIs; browsers never do.

# This site's own address, as Bishnoi One Platform knows it (the Platform's
# ONE_APP_URL must be the same online). Unset: http://localhost:4301.
# ONE_APP_URL=https://one.bishnoi.ai

# The one backend (every module's API, each under its path: /platform, /crm,
# /inventory, /finance, /admin, /pharmacy...), as this site's server reaches it.
# Unset: http://127.0.0.1:8300 (this computer). On the server, the backend's
# internal address, e.g. http://10.0.1.1:8300. Nothing else to set per module.
# BACKEND_URL=http://127.0.0.1:8300

# Only for a server reached inside the office over plain http (never online):
# ALLOW_HTTP_SIGN_IN=true

# On the server, once Cloudflare is in front: only its CF-Connecting-IP is taken as the visitor's address.
# TRUST_FORWARDED_FOR=false
