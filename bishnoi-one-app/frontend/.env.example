# Copy to .env.local and adjust. Never commit .env.local.
# Bishnoi One's one app: every module's screens on one site. Only the Next
# server talks to the APIs; browsers never do.

# This site's own address, as Bishnoi One Platform knows it (the Platform's
# ONE_APP_URL must be the same online). Unset: http://localhost:4301.
# ONE_APP_URL=https://one.bishnoi.ai

# Bishnoi One Platform's API: the one sign-in (Bishnoi One accounts), and the
# Platform module's API. Unset: http://127.0.0.1:8305.
# PLATFORM_API_URL=http://127.0.0.1:8305

# Each module's API. Unset: the addresses on this computer (127.0.0.1:830x).
# On the server, the addresses the screens reach them at (e.g. http://10.0.1.1:8302).
# CRM_API_URL=http://127.0.0.1:8302
# INVENTORY_API_URL=http://127.0.0.1:8304
# FINANCE_API_URL=http://127.0.0.1:8303
# ADMIN_API_URL=http://127.0.0.1:8300
# PHARMACY_API_URL=http://127.0.0.1:8307
# INLICENSING_API_URL=http://127.0.0.1:8306
# REGULATORY_API_URL=http://127.0.0.1:8308

# Only for a server reached inside the office over plain http (never online):
# ALLOW_HTTP_SIGN_IN=true
