# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# This app's own database: its users, sessions and data. SQLite in .data/ by
# default; point it at Postgres (postgres://... as Neon or Supabase give it)
# without touching anything else. Every table is nbph_...
# DATABASE_URL=sqlite:///.data/pharmacy.db

# The first administrator, for a host you can't run the users tool against
# (Vercel). Used only while the database has no accounts; remove the password
# once they've signed in.
# FIRST_ADMIN_EMAIL=you@example.com
# FIRST_ADMIN_NAME=Your Name
# FIRST_ADMIN_PASSWORD=

# How long a sign-in lasts, in hours.
# SESSION_HOURS=10

# Signing in with a Nabhi account: the platform's public key (base64; the
# platform's /pass/key shows it, and scripts/deploy-keys.mjs makes the pair).
# Unset: only this app's own accounts sign in.
# PLATFORM_PUBLIC_KEY=

# A batch expiring within this many days is flagged as expiring soon.
# EXPIRY_WARNING_DAYS=90
# A prescription older than this many days can't be verified.
# PRESCRIPTION_VALID_DAYS=180

# The company this app belongs to, as its screens show it.
# ORG_NAME=Nabhi
# ORG_CURRENCY=PHP
# ORG_LOCALE=en-PH
# ORG_TIMEZONE=Asia/Manila

# Host names this API answers to, as JSON.
# ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Browser origins allowed to call this API directly, as JSON. Empty by default:
# the Next server calls it, browsers don't.
# CORS_ORIGINS=[]

# --- Discord (app/discord.py) --------------------------------------------------
# This app's log goes to Discord: a thread a day in the logs channel, named
# LOG-PHARMACY-YYYYMMDD, one line per change (what, to what, who, when; never values).
# Master off switch: nothing goes to Discord unless this is true.
# DISCORD_ENABLED=false
# mock = nothing leaves this machine (a local file in .data/discord-mock/ stands
# in for Discord); live = really post.
# DISCORD_MODE=mock
# The bot: reads the channels back and starts the threads. Developer Portal >
# your app > Bot > Reset Token; turn on Message Content Intent there.
# DISCORD_BOT_TOKEN=
# A webhook in the logs channel (channel > Edit Channel > Integrations >
# Webhooks > New Webhook). Every app may use the same one.
# DISCORD_LOGS_WEBHOOK_URL=
# Most messages a minute. Discord allows about 30 per channel; more wait their turn.
# DISCORD_MAX_PER_MINUTE=30

# Other Nabhi apps that send orders here for the pharmacist's check, as
# name:key pairs in JSON. Give the CRM its key as PHARMACY_API_KEY.
# INTEGRATION_KEYS=["crm:<a long random key, 24 characters or more>"]
