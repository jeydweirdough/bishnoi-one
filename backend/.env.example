# Settings for Bishnoi One's one backend (every module). Copy to .env and adjust; never commit .env.
# npm run setup makes .env from this file the first time.
#
# A setting here applies to every module that has it. <MODULE>_<SETTING> applies to one module
# and wins over it (PLATFORM_, CRM_, INVENTORY_, FINANCE_, ADMIN_, PHARMACY_, IN_LICENSING_,
# REGULATORY_), e.g. CRM_DATABASE_URL. Every module's settings are described in its own
# modules/<module>/.env.example.

ENVIRONMENT=development

# The database. Unset: each module's own SQLite file in backend/.data/. On the server, one
# PostgreSQL for every module (tables never clash: each module has its own prefix and its own
# migration history); each CRM/Inventory company gets a database of its own beside it.
# DATABASE_URL=postgresql://user:password@host:5432/bishnoione

# The backend's own address, as the modules and the one app reach it. Every module is at
# BACKEND_URL + its path (/platform, /crm, /inventory, /finance, /admin, /pharmacy,
# /in-licensing, /regulatory): PLATFORM_API_URL, INVENTORY_API_URL... follow it unless set, and
# the Platform reports these addresses in Applications. Unset: http://127.0.0.1:8300.
# On the server: the backend's internal address, e.g. http://10.0.1.1:8300.
# BACKEND_URL=http://127.0.0.1:8300

# The one app's address (every module's screens), for sign-in redirects and links in emails.
ONE_APP_URL=http://localhost:4301
