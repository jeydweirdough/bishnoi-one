# The one backend (Python). The repository's own .gitignore covers the rest.

# Secrets. Never commit these; each module's .env.example documents the names instead.
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Local data of every module: databases, the records file store, uploaded files, keys,
# pre-migration copies
.data/
.data-before-*/
*.db
*.db-shm
*.db-wal
*.sqlite3

# Local Claude plugin data
.claude/data/
